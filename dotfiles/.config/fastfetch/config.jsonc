{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "$include": "themes/noctalia.jsonc",
  "logo": null,
  "display": {
    "separator": "  ",

  },
  "modules": [
    "break",
    {
      "type": "custom",
      "key": "╭───────────────────────────────────╮"
    },
    {
      "type": "kernel",
      "key": "│ {#keys}{#}  kernel",
      "format": "{#keys}{release>22}{#} │"
    },
    {
      "type": "command",
      "key": "│   uptime",
      "text": "uptime -p | cut -d ' ' -f 2-",
      "format": "{>22} │"
    },
    {
      "type": "shell",
      "key": "│ {#keys}{#}  shell ",
      "format": "{#keys}{pretty-name>22}{#} │"
    },
    {
      "type": "command",
      "key": "│ {#title}{#}  mem   ",
      "text": "free -m | awk 'NR==2{printf \"%.2f GiB / %.2f GiB\",$3/1024,$2/1024}'",
      "format": "{#title}{>22}{#} │"
    },
    {
      "type": "packages",
      "key": "│   pkgs  ",
      "format": "{all>22} │"
    },
    {
      "type": "command",
      "key": "│ {#keys}{#}  user  ",
      "text": "echo $USER",
      "format": "{#keys}{>22}{#} │"
    },
    {
      "type": "command",
      "key": "│   hname ",
      "text": "hostnamectl hostname",
      "format": "{>22} │"
    },
    {
      "type": "os",
      "key": "│ {#title}󰻀{#}  distro",
      "format": "{#title}{pretty-name>22}{#} │"
    },
    {
      "type": "custom",
      "key": "╰───────────────────────────────────╯"
    },
    "break"
  ]
}
